# ==============================================================================
# TaxGuard API - Environment Configuration Template
# ==============================================================================
# Copy this file to .env and adjust variables as needed for your environment.

# Application
PROJECT_NAME="TaxGuard API"
VERSION="1.1.0"
ENVIRONMENT="development"
DEBUG=true
API_V1_STR="/api/v1"

# Security & JWT
# IMPORTANT: Generate a strong secret in production: openssl rand -hex 32
SECRET_KEY="super_secret_taxguard_key_for_development_purposes_only_replace_in_prod"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080
STRIPE_WEBHOOK_SECRET="whsec_taxguard_dev_secret_key"

# Database Configuration (PostgreSQL 16)
# Local connection string (outside Docker):
DATABASE_URL="postgresql+asyncpg://taxguard:taxguard_secret@localhost:5432/taxguard_db"
# Docker Compose internal network connection string:
# DATABASE_URL="postgresql+asyncpg://taxguard:taxguard_secret@db:5432/taxguard_db"

# Redis Configuration (Redis 7)
# Local connection string (outside Docker):
REDIS_URL="redis://localhost:6379/0"
# Docker Compose internal network connection string:
# REDIS_URL="redis://redis:6379/0"

# CORS Allowed Origins (Comma-separated or JSON array)
CORS_ORIGINS='["*"]'
